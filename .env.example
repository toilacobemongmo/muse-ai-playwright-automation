# Browser Configuration
HEADLESS=false
DEVTOOLS=false
SLOW_MO=0

# Timeouts (milliseconds)
TIMEOUT_NAV=45000
TIMEOUT_WAIT=15000
TIMEOUT_ACTION=8000
TIMEOUT_STREAM=120000

# Paths
PROMPTS_DIR=./data/prompts
OUTPUT_DIR=./data/outputs
DOWNLOADS_DIR=./data/downloads
AUTH_SESSION_FILE=./data/auth/session.json
LOGS_DIR=./data/logs

# Retry Policy
MAX_RETRIES=3

# Target URL (customize for your use case)
TARGET_URL=https://example.com/chat

# Optional: 2Captcha API Key
TWOCAPTCHA_API_KEY=
